jenkins:
  systemMessage: "Capstone Jenkins (bootstrapped by Ansible + JCasC)"
  mode: NORMAL
  numExecutors: 2

  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: "admin"
          password: "{{ jcasc_admin_password }}"

  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false

  nodes:
    - permanent:
        name: "jenkins-worker-1"
        remoteFS: "/home/ubuntu/jenkins"
        numExecutors: 2
        mode: NORMAL
        labelString: "linux docker worker"
        retentionStrategy: "always"
        launcher:
          ssh:
            host: "{{ jcasc_worker_private_ip }}"
            port: 22
            credentialsId: "agent-ssh"
            sshHostKeyVerificationStrategy: "nonVerifyingKeyVerificationStrategy"

credentials:
  system:
    domainCredentials:
      - credentials:
          - basicSSHUserPrivateKey:
              scope: SYSTEM
              id: "agent-ssh"
              username: "ubuntu"
              description: "Controller -> worker SSH key (generated by Ansible)"
              privateKeySource:
                directEntry:
                  privateKey: |
{{ jcasc_controller_private_key | indent(20, true) }}
          - usernamePassword:
              scope: GLOBAL
              id: "github-http"
              username: "{{ jcasc_github_username }}"
              password: "{{ jcasc_github_token }}"
              description: "GitHub HTTPS token for Jenkins pipeline jobs"

jobs:
  - script: |
      freeStyleJob('test-agent') {
        description('Quick test job to verify agent + docker + java.')
        label('worker')
        logRotator { numToKeep(25) }

        steps {
          shell('''#!/usr/bin/env bash
      set -euxo pipefail

      echo "=== whoami ==="
      whoami

      echo "=== hostname ==="
      hostname

      echo "=== java ==="
      java -version || true

      echo "=== docker ==="
          docker --version || true
          docker ps || true
          ''')
        }
      }
  - script: |
      pipelineJob('deploy-capstone-app') {
        description('Builds the static Nginx app and deploys it to the app server.')

        parameters {
          stringParam('APP_SERVER_HOST', '{{ jcasc_app_server_private_ip }}', 'Private IP or DNS name of the app server')
        }

        triggers {
          scm('H/2 * * * *')
        }

        definition {
          cpsScm {
            scm {
              git {
                remote {
                  url('https://github.com/salorozco/devops-capstone-two.git')
                  credentials('github-http')
                }
                branch('*/main')
              }
            }
            scriptPath('Jenkinsfile')
          }
        }
      }
